{
  "name": "ascii-engine-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ascii-engine/editor dev",
    "api": "pnpm --filter @ascii-engine/automation api",
    "mcp": "pnpm --silent --filter @ascii-engine/automation mcp",
    "build": "pnpm -r build",
    "pages:build": "node scripts/build-pages.mjs",
    "test": "node --test scripts/export-args.test.mjs scripts/bench-stats.test.mjs scripts/bench-cases.test.mjs scripts/bench-capacity-data.test.mjs && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "check": "pnpm format:check && node scripts/check-package-boundaries.mjs && pnpm typecheck && pnpm test && pnpm build",
    "tauri": "pnpm --filter @ascii-engine/editor tauri",
    "compare": "node scripts/compare.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:report": "node scripts/bench-report.mjs",
    "verify:visual": "node scripts/verify-visual.mjs",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:composition": "node scripts/verify-composition.mjs",
    "verify:display": "node scripts/verify-display.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "verify:authoring": "node scripts/verify-authoring.mjs",
    "verify:textures": "node scripts/verify-textures.mjs",
    "verify:gltf": "node scripts/verify-gltf-appearance.mjs",
    "export": "node scripts/export.mjs",
    "verify:water": "node scripts/verify-water.mjs",
    "bench:capacity": "node scripts/bench-capacity.mjs"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
